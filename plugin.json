{
  "id": "ru.senior-sigan.stickers",
  "name": "Stickers",
  "description": "PNG stickers with a scrollable picker and one-click sending.",
  "version": "0.1.6",
  "min_server_version": "11.7.3",
  "server": {
    "executables": {
      "linux-amd64": "server/plugin-linux-amd64",
      "linux-arm64": "server/plugin-linux-arm64"
    }
  },
  "webapp": {
    "bundle_path": "webapp/main.js"
  },
  "settings_schema": {
    "settings": [
      {
        "key": "StickerLibrary",
        "display_name": "Каталог стикеров",
        "type": "custom",
        "help_text": "Добавление PNG в общий каталог. Доступно только системным администраторам."
      }
    ]
  }
}
